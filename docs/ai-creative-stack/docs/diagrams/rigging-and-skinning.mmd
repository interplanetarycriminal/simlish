%% render: auto
%% title: Rigging and skinning
%% desc: A predicted rig is a starting point. Test poses decide whether it ships.
flowchart TD
    A["Validated mesh • manifold, scaled, deformation topology"]:::amber
    B["Skeleton prediction • UniRig, or hand-placed joints"]:::amber
    C["Skinning weight prediction • UniRig, or automatic weights"]:::amber
    D["Rig import into Blender • FBX"]:::amber
    E["Joint and weight inspection • validate_asset.py report"]:::green
    F["Test poses • bend every joint to its limit"]:::blue
    G{"Deformation acceptable?"}:::slate
    H["Refine rig and weights • weight paint, bone roll, loops"]:::amber
    I["Animation-ready asset • FBX or GLB plus report"]:::green
    A -->|OBJ, FBX, GLB| B
    B --> C
    C -->|FBX| D
    D --> E
    E --> F
    F --> G
    G -->|No| H
    H -.->|retest| F
    G -->|Yes| I
