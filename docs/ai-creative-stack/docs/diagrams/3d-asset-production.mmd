    F --> G
    G -->|Yes| H
    G -->|No| I
    H -->|OBJ| I
    I --> J
    J --> K
    K -->|Yes| L
    K -->|No| M
    L -->|FBX| M
    M --> N
    N --> O
    O --> P
    O --> Q
    O --> R
    P --> S
    R --> T
