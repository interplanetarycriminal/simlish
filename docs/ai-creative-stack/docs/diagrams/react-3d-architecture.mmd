%% render: auto
%% title: React 3D scene architecture
%% desc: React Three Fiber renders Three.js declaratively. One frame loop, one animation owner per transform.
flowchart TD
    A["Validated GLB • Blender or Blockbench"]:::amber
    B["Loader • useGLTF or GLTFLoader"]:::blue
    C["React Three Fiber scene • components"]:::blue
    D["Three.js renderer • underneath"]:::blue
    E["Animation owner • mixer, Theatre track or GSAP"]:::teal
    F["Frame loop • always, demand or never + advance()"]:::slate
    G["Checks • memory, resize, context loss, fallback"]:::green
    A -->|GLB| B
    B --> C
    C --> D
    E --> C
    F --> D
    D --> G
