%% render: auto
%% title: Production application interface
%% desc: Each arrow names the artifact the next step receives.
flowchart TD
    N0["Roles and task flows • research, permissions, data model"]:::slate
    N1["Tokens and prototypes • empty, loading, error, success"]:::purple
    N2["Reusable UI states • typed components on fixtures"]:::blue
    N3["Interaction audit • keyboard, focus, announcements"]:::green
    N4["Automated tests • primary path and recovery"]:::green
    N0 -->|flow map| N1
    N1 -->|state screens + tokens| N2
    N2 -->|component build| N3
    N3 -->|audited states| N4
    N4 -.->|regression| N2
    classDef slate fill:#edf2f7,stroke:#596b84,color:#142137
    classDef purple fill:#f0e8fc,stroke:#733ed0,color:#142137
    classDef blue fill:#e7effe,stroke:#2363cf,color:#142137
    classDef amber fill:#fff0da,stroke:#a05212,color:#142137
    classDef teal fill:#dff6f0,stroke:#087d73,color:#142137
    classDef rose fill:#fee8ed,stroke:#bf315c,color:#142137
    classDef green fill:#e1f4e7,stroke:#198047,color:#142137
