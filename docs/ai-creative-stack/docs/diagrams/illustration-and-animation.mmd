%% render: auto
%% title: Illustration and animated storytelling
%% desc: Each arrow names the artifact the next step receives.
flowchart TD
    N0["Approve the style • one sample figure, silhouette, line"]:::purple
    N1["Create SVG assets • stable viewBox, paths, names"]:::amber
    N2["Sequence motion • storyboard timing, one compositor"]:::teal
    N3["Inspect the rhythm • frame sheets at delivery size"]:::green
    N4["Deliver fallback • static or reduced-motion version"]:::green
    N0 -->|approved sample| N1
    N1 -->|SVG or alpha frames| N2
    N2 -->|test segment| N3
    N3 -->|approved sequence| N4
    N3 -.->|off-model or off-beat| N1
