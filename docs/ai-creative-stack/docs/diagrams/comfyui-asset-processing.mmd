%% render: auto
%% title: Repeatable ComfyUI asset processing
%% desc: A reviewed workflow JSON is the unit of repeatability. Everything it needs is pinned.
flowchart TD
    A["Approved workflow definition • JSON, seeds, parameters"]:::slate
    B["Pinned environment • ComfyUI, nodes, checkpoints, hashes"]:::slate
    C["Asset generation • supported 3D nodes only"]:::amber
    D["Geometry processing • remesh, decimate, transform"]:::amber
    E["Texture baking • UVs and maps"]:::amber
    F["Export • GLB or OBJ per asset"]:::amber
    G["Batch quality assurance • validate_asset.py per output"]:::green
    A --> B
    B --> C
    C --> D
    D --> E
    E --> F
    F -->|files + manifest| G
    G -.->|reject| C
    classDef slate fill:#edf2f7,stroke:#596b84,color:#142137
    classDef purple fill:#f0e8fc,stroke:#733ed0,color:#142137
    classDef blue fill:#e7effe,stroke:#2363cf,color:#142137
    classDef amber fill:#fff0da,stroke:#a05212,color:#142137
    classDef teal fill:#dff6f0,stroke:#087d73,color:#142137
    classDef rose fill:#fee8ed,stroke:#bf315c,color:#142137
    classDef green fill:#e1f4e7,stroke:#198047,color:#142137
