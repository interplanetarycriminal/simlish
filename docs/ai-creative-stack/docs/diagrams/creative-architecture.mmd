    classDef purple fill:#f0e8fc,stroke:#733ed0,color:#142137
    classDef blue fill:#e7effe,stroke:#2363cf,color:#142137
    classDef amber fill:#fff0da,stroke:#a05212,color:#142137
    classDef teal fill:#dff6f0,stroke:#087d73,color:#142137
    classDef rose fill:#fee8ed,stroke:#bf315c,color:#142137
    classDef green fill:#e1f4e7,stroke:#198047,color:#142137
