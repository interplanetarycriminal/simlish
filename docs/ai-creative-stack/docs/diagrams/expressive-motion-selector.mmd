%% render: auto
%% title: Expressive motion selector
%% desc: Choose one representation per asset, one motion owner per property, then inspect the rendered result.
flowchart TD
    A["Idea and approved style"]:::purple
    B{"Representation"}:::slate
    C["Ink and sketch • Line Art Animation, Rough.js, sketchy"]:::amber
    D["Pixel raster • Pixelorama, pixelfx"]:::amber
    E["3D • Blender, Three.js, React Three Fiber"]:::amber
    F["Motion owner • Motion, GSAP or Theatre.js"]:::teal
    G["Sprite atlas or engine playback"]:::teal
    H["Optional accents • Sakuga VFX"]:::teal
    I["Play or render, then inspect"]:::green
    J["Critique • motionmaxxing or Hallmark; fix the owner, re-run"]:::green
    A --> B
    B --> C
    B --> D
    B --> E
    C --> F
    E --> F
    D --> G
    F -.->|optional| H
    F --> I
    G --> I
    H -.-> I
    I --> J
    classDef slate fill:#edf2f7,stroke:#596b84,color:#142137
    classDef purple fill:#f0e8fc,stroke:#733ed0,color:#142137
    classDef blue fill:#e7effe,stroke:#2363cf,color:#142137
    classDef amber fill:#fff0da,stroke:#a05212,color:#142137
    classDef teal fill:#dff6f0,stroke:#087d73,color:#142137
    classDef rose fill:#fee8ed,stroke:#bf315c,color:#142137
    classDef green fill:#e1f4e7,stroke:#198047,color:#142137
